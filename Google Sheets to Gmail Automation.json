    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all().map(item => item.json);\n\n// Remove extra spaces from Google Sheets column names\nconst cleanRows = rows.map(row => {\n  const cleaned = {};\n  for (const key of Object.keys(row)) {\n    cleaned[key.trim().toLowerCase()] = row[key];\n  }\n  return cleaned;\n});\n\n// Keep rows that contain student information\nconst validRows = cleanRows.filter(row =>\n  [row.name, row.course, row.status].some(\n    value => String(value ?? \"\").trim() !== \"\"\n  )\n);\n\n// Stop if no valid data exists\nif (validRows.length === 0) {\n  return [];\n}\n\n// Format each student\nconst details = validRows.map((row, index) =>\n  `${index + 1}. Name: ${row.name || \"Not provided\"}\nCourse: ${row.course || \"Not provided\"}\nStatus: ${row.status || \"Not provided\"}`\n).join(\"\\n\\n\");\n\n// Create email content\nconst subject = \"Data Summary from Google Sheet\";\n\nconst body = `Hi,\n\nHere is the latest data from the sheet:\n\n${details}\n\nTotal Students: ${validRows.length}\n\nRegards,\nYour Automation Bot`;\n\nreturn [{json:{subject,body}}];\n"
      },
      "type": "n8n-nodes-base.code",
